# app
NEXT_PUBLIC_APP_URL = "http://localhost:3000"
NEXT_PUBLIC_APP_NAME = "chatgptimage2"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# database
DATABASE_PROVIDER="postgresql"
DATABASE_URL="postgresql://user:password@host:5432/db"
DB_SCHEMA_FILE = "./src/config/db/schema.postgres.ts"
DB_MIGRATIONS_OUT = "./src/config/db/migrations"
DB_SINGLETON_ENABLED="true"
DB_MAX_CONNECTIONS="1"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = "replace-with-openssl-rand-base64-32-value"

# 风控配置
NEXT_PUBLIC_RISK_CONTROL_MAX_ATTEMPTS=10
NEXT_PUBLIC_RISK_CONTROL_WINDOW_HOURS=24
NEXT_PUBLIC_RISK_CONTROL_RESET_HOURS=24
NEXT_PUBLIC_RISK_CONTROL_FINGERPRINT_ENABLED=true

# 定时任务认证令牌
CRON_AUTH_TOKEN=your-cron-auth-token-here
